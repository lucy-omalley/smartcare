# =============================================================================
# Parenfy — Environment variables (Vercel / local .env.local)
# Copy to .env.local for local dev. Never commit real secrets.
# =============================================================================

# --- Required: core ---
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Required: AI ---
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_LARGE=gpt-4o
# OPENAI_MAX_TOKENS=1000

# --- AI emergency controls (optional) ---
# Set to false/0/off to disable expensive AI generation site-wide
# AI_GENERATION_ENABLED=true
# Daily spend cap in USD (from AIUsageLog; image/TTS costs may be undercounted)
# AI_DAILY_COST_LIMIT=50

# --- Required: production registration protection (pick one) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# OR Cloudflare Turnstile:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Dev only — skips CAPTCHA requirement (NEVER set true in production):
# ALLOW_INSECURE_REGISTRATION=true

# --- Strongly recommended: rate limits ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OAuth (optional but typical for beta) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# --- Email (password reset + email verification) ---
# 1. Verify parenfy.com (or mail.parenfy.com) in Resend → Domains
# 2. Add Resend SPF + DKIM DNS records; publish DMARC (see Resend dashboard)
# 3. Use a verified From address — display name + domain must match DNS
RESEND_API_KEY=
EMAIL_FROM="Parenfy <hello@parenfy.com>"
# Optional: dedicated sender for verification (recommended: verify@mail.parenfy.com)
# EMAIL_VERIFICATION_FROM="Parenfy <verify@mail.parenfy.com>"
EMAIL_REPLY_TO=hello@parenfy.com

# --- Error monitoring (recommended for beta) ---
SENTRY_DSN=
# Optional: expose DSN to client for browser error capture (can reuse SENTRY_DSN)
NEXT_PUBLIC_SENTRY_DSN=

# --- Stripe (optional until paid tiers launch) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_FAMILY_PRICE_ID=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_KEY=

# --- Admin access ---
ADMIN_EMAIL=
FOUNDER_ADMIN_EMAILS=

# --- Family Voice Storytime (optional — enables real voice cloning) ---
# Create at https://elevenlabs.io/app/settings/api-keys
# Use an unrestricted key, or enable Voices (read+write) + Text to Speech.
# Paste only the key value — no quotes — then redeploy Vercel Production.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Misc ---
# OPENWEATHER_API_KEY=
