generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemoryCategory {
  MILESTONE
  ROUTINE
  PREFERENCE
  LEARNING
  BEHAVIOUR
  FUNNY_MOMENT
  CONCERN
  FAVOURITE_THINGS
  JOURNAL
}

enum PostType {
  QUESTION
  RECOMMENDATION
  STORY
}

enum ExchangeCategory {
  BOOKS
  TOYS
  CLOTHES
  BABY_EQUIPMENT
}

enum ActivityCategory {
  LIBRARY
  MUSEUM
  COMMUNITY_CENTRE
  PLAYGROUP
  FESTIVAL
  OTHER
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ConnectRequestType {
  STATUS_INTEREST
  EVENT_JOIN
}

enum EventParticipantStatus {
  JOINED
  REQUESTED
  DECLINED
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  FAMILY
}

enum KnowledgeTipCategory {
  BEHAVIOUR
  SLEEP
  EATING
  SPEECH
  POTTY
  EMOTIONAL
  GENERAL
}

enum AIFeature {
  TODAY_PLAN
  WEEKLY_PLAN
  CHAT
  COACHING
  REFLECTION
  PERSONALIZE
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  password           String?
  image              String?
  childNickname      String?
  childAge           String?
  childBirthday      String?
  childGender        String?
  childInterests     String[] @default([])
  favouriteToys      String[] @default([])
  favouriteThemes    String[] @default([])
  favouriteBooks     String[] @default([])
  favouriteFoods     String[] @default([])
  foodDislikes       String[] @default([])
  sleepRoutine       String?
  schoolNursery      String?
  personality        String?
  homeLanguage       String?
  foodPreferences    String[] @default([])
  routineNotes       String?
  developmentNotes   String?
  weeklyFocusTitle   String?
  weeklyFocusReason  String?
  weeklyFocusWeekStart DateTime? @db.Date
  parentingGoal      String?
  parentingGoals     String[] @default([])
  priorityGoal       String?
  currentChallenges  String[] @default([])
  location           String?
  broadArea          String?
  bio                String?
  interests          String[] @default([])
  visibilityPreference String @default("public")
  openToConnect      Boolean  @default(true)
  onboardingComplete Boolean  @default(false)
  planTier           SubscriptionPlan @default(FREE)
  isAdmin            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  memories            FamilyMemory[]
  conversations       Conversation[]
  posts               CommunityPost[]
  meetups             Meetup[]
  meetupJoins         MeetupAttendee[]
  activities          Activity[]
  listings            ExchangeListing[]
  reflections         WeeklyReflection[]
  dailyBriefs         DailyBrief[]
  savedRecipes        SavedRecipe[]
  savedStories        SavedStory[]
  rotateLibrary       UserRotateLibrary?
  usageQuota          UserUsageQuota?
  aiUsageLogs         AIUsageLog[]
  sentConnections     ParentConnection[] @relation("SentConnections")
  receivedConnections ParentConnection[] @relation("ReceivedConnections")
  parentMessages      ParentMessage[]
  parentStatuses      ParentStatus[]
  connectEvents       ConnectEvent[]
  eventParticipations EventParticipant[]
  sentConnectRequests ConnectRequest[] @relation("SentConnectRequests")
  receivedConnectRequests ConnectRequest[] @relation("ReceivedConnectRequests")

  @@index([email])
  @@index([location])
  @@index([broadArea])
  @@index([openToConnect])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FamilyMemory {
  id        String         @id @default(cuid())
  userId    String
  content   String
  category  MemoryCategory @default(PREFERENCE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  content        String
  isUser         Boolean
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CommunityPost {
  id          String   @id @default(cuid())
  userId      String
  type        PostType
  title       String
  content     String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Meetup {
  id            String           @id @default(cuid())
  userId        String
  title         String
  date          DateTime
  time          String
  location      String
  childAgeRange String
  maxAttendees  Int              @default(10)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendees     MeetupAttendee[]

  @@index([userId])
  @@index([date])
}

model MeetupAttendee {
  id       String   @id @default(cuid())
  meetupId String
  userId   String
  joinedAt DateTime @default(now())
  meetup   Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetupId, userId])
}

model Activity {
  id          String           @id @default(cuid())
  userId      String?
  title       String
  description String
  category    ActivityCategory @default(OTHER)
  date        DateTime
  location    String
  createdAt   DateTime         @default(now())
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
}

model ExchangeListing {
  id          String           @id @default(cuid())
  userId      String
  category    ExchangeCategory
  title       String
  description String
  condition   String
  location    String
  photoUrl    String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model WeeklyReflection {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime
  content   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
}

model DailyBrief {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  content         Json
  storyAudioData  Bytes?
  storyAudioHash  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model UserRotateLibrary {
  id          String   @id @default(cuid())
  userId      String   @unique
  profileHash String
  recipes     Json     @default("[]")
  play        Json     @default("[]")
  stories     Json     @default("[]")
  language    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedStory {
  id              String   @id @default(cuid())
  userId          String
  title           String
  story           String   @db.Text
  moral           String?
  illustrationData String? @db.Text
  audioData       Bytes?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ParentConnection {
  id           String           @id @default(cuid())
  requesterId  String
  recipientId  String
  status       ConnectionStatus @default(PENDING)
  introMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requester    User             @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient    User             @relation("ReceivedConnections", fields: [recipientId], references: [id], onDelete: Cascade)
  thread       ParentThread?

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}

model ParentStatus {
  id            String   @id @default(cuid())
  userId        String
  broadArea     String
  timeWindow    String
  interest      String
  childAgeRange String
  note          String?
  isOpen        Boolean  @default(true)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests      ConnectRequest[]

  @@index([userId])
  @@index([expiresAt])
  @@index([isOpen])
}

model ConnectEvent {
  id               String   @id @default(cuid())
  organiserId      String
  title            String
  broadArea        String
  exactLocation    String?
  date             DateTime @db.Date
  timeWindow       String
  activityType     String
  childAgeRange    String
  maxParticipants  Int?
  description      String?
  visibility       String   @default("public")
  joinApprovalType String   @default("auto")
  status           String   @default("published")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organiser        User     @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  participants     EventParticipant[]
  requests         ConnectRequest[]

  @@index([organiserId])
  @@index([date])
  @@index([status])
}

model EventParticipant {
  id        String                 @id @default(cuid())
  eventId   String
  userId    String
  status    EventParticipantStatus @default(JOINED)
  createdAt DateTime               @default(now())
  event     ConnectEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model ConnectRequest {
  id          String             @id @default(cuid())
  requesterId String
  recipientId String
  statusId    String?
  eventId     String?
  requestType ConnectRequestType
  status      ConnectionStatus   @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  requester   User               @relation("SentConnectRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User               @relation("ReceivedConnectRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  parentStatus ParentStatus?     @relation(fields: [statusId], references: [id], onDelete: SetNull)
  event       ConnectEvent?      @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
  @@index([statusId])
  @@index([eventId])
}

model ParentThread {
  id           String           @id @default(cuid())
  connectionId String           @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  connection   ParentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages     ParentMessage[]

  @@index([updatedAt])
}

model ParentMessage {
  id        String       @id @default(cuid())
  threadId  String
  senderId  String
  content   String       @db.Text
  createdAt DateTime     @default(now())
  thread    ParentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  event      String
  properties Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([createdAt])
}

model AnalyticsError {
  id        String   @id @default(cuid())
  userId    String?
  source    String
  message   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

model BetaFeedback {
  id          String   @id @default(cuid())
  userId      String?
  enjoyed     String?  @db.Text
  confused    String?  @db.Text
  improve     String?  @db.Text
  recommend   String?  @db.Text
  rating      Int?
  page        String?
  deviceType  String?
  appVersion  String?
  signedIn    Boolean  @default(false)
  daysSinceSignup Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// --- Structured knowledge base (DB-first content; AI only personalizes selection) ---

model KnowledgeMilestone {
  id           String   @id @default(cuid())
  slug         String   @unique
  minAgeMonths Int
  maxAgeMonths Int
  category     String
  title        String
  description  String   @db.Text
  whyItMatters String?  @db.Text
  parentTip    String?  @db.Text
  tags         String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([minAgeMonths, maxAgeMonths])
  @@index([category])
}

model KnowledgeActivity {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  minAgeMonths         Int
  maxAgeMonths         Int
  indoorOutdoor        String   @default("either")
  rainyDay             Boolean  @default(true)
  sunnyDay             Boolean  @default(true)
  durationMinutes      Int
  materials            String[] @default([])
  instructions         String[] @default([])
  detailedInstructions String[] @default([])
  skillsDeveloped      String[] @default([])
  tags                 String[] @default([])
  reason               String?  @db.Text
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([minAgeMonths, maxAgeMonths])
  @@index([indoorOutdoor])
}

model KnowledgeRecipe {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  subtitle             String
  minAgeMonths         Int
  maxAgeMonths         Int
  prepTimeMinutes      Int
  ingredients          String[] @default([])
  steps                String[] @default([])
  detailedSteps        String[] @default([])
  nutritionTags        String[] @default([])
  whyThisMeal          String?  @db.Text
  healthyTip           String?
  tags                 String[] @default([])
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([minAgeMonths, maxAgeMonths])
}

model KnowledgeStory {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleTemplate String
  theme         String
  minAgeMonths  Int
  maxAgeMonths  Int
  storyTemplate String   @db.Text
  moral         String?
  lengthMinutes Int      @default(4)
  tags          String[] @default([])
  reason        String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([minAgeMonths, maxAgeMonths])
  @@index([theme])
}

model KnowledgeBook {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  author       String?
  minAgeMonths Int
  maxAgeMonths Int
  language     String   @default("English")
  theme        String
  summary      String   @db.Text
  tags         String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([minAgeMonths, maxAgeMonths])
}

model KnowledgeSong {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  minAgeMonths Int
  maxAgeMonths Int
  category     String
  lyrics       String?  @db.Text
  tags         String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([minAgeMonths, maxAgeMonths])
}

model KnowledgeGame {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  minAgeMonths Int
  maxAgeMonths Int
  indoor       Boolean  @default(true)
  outdoor      Boolean  @default(false)
  solo         Boolean  @default(false)
  parentChild  Boolean  @default(true)
  description  String   @db.Text
  howToPlay    String[] @default([])
  tags         String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([minAgeMonths, maxAgeMonths])
}

model KnowledgeTip {
  id           String               @id @default(cuid())
  slug         String               @unique
  category     KnowledgeTipCategory
  minAgeMonths Int
  maxAgeMonths Int
  title        String
  content      String               @db.Text
  tryToday     String?
  tags         String[]             @default([])
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())

  @@index([category])
  @@index([minAgeMonths, maxAgeMonths])
}

// Semantic cache — DB-backed; swap to Redis via AICacheService without changing callers
model AICacheEntry {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  feature   AIFeature
  response  Json
  expiresAt DateTime
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feature, expiresAt])
}

model AIUsageLog {
  id               String    @id @default(cuid())
  userId           String?
  feature          AIFeature
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  estimatedCostUsd Float     @default(0)
  cacheHit         Boolean   @default(false)
  metadata         Json?
  createdAt        DateTime  @default(now())
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
}

model UserUsageQuota {
  id                   String   @id @default(cuid())
  userId               String   @unique
  dailyPlansToday      Int      @default(0)
  chatsToday           Int      @default(0)
  generationsThisMonth Int      @default(0)
  lastDailyReset       DateTime @db.Date
  lastMonthlyReset     DateTime @db.Date
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
